# Development: copy this file to api/.env and fill in every value. make api loads it.
# Production: the same variables live in ~/apps/dashboard/.env on the VM.
# Write plain KEY=value with no quotes and no spaces, so the shell and Docker Compose both read it.

# The site's origin, with no trailing slash. In development this is the Vite address, http://localhost:5173
PUBLIC_URL=

# Signing key for session cookies, at least 32 bytes. Generate one with: openssl rand -hex 32
SESSION_KEY=

# Google OAuth client. Register <PUBLIC_URL>/api/auth/google/callback as its redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The owner's Google account ID (the "sub" claim). To find it, put a placeholder here and sign in once.
# The API refuses the sign-in and logs the ID to copy in.
OWNER_GOOGLE_SUB=
